#
# H3C Magic NX30 Pro 112M (NMBM layout) - ImmortalWrt 24.10 增量配置
#
# 用法：先写 target 三项，再 make defconfig 生成完整 .config，
#       然后把本文件追加到 .config 末尾，再 make defconfig 规范化一次。
#
# 设计原则：不复制整份 .config（上游一变就烂），只写"我们需要而默认没有"的项。
#

# --- Target / Device ------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_h3c_magic-nx30-pro-112m=y

# 根文件系统大小。注意单位是 **MiB 不是 KB**（config/Config-images.in 原文：
#   int "Root filesystem partition size (in MiB)"）
# 设成 104448 会被理解成 102 GiB，直接炸掉 check-size。
# UBI 布局（KERNEL_IN_UBI=1）下该参数可能不生效——rootfs_data 卷会由内核
# 自动 resize 吃满 ubi 剩余空间（实测日志：re-sized from 9 to 763 LEBs）。
# 这里保留 104 仅作上限保护。
CONFIG_TARGET_ROOTFS_PARTSIZE=104

# --- 基础 LuCI 中文 -------------------------------------------------
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# --- Argon 主题（官方源自带）----------------------------------------
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# --- nikki（mihomo 透明代理）----------------------------------------
# luci-app-nikki -> nikki -> mihomo-meta（Go 源码编译进固件）
# 编进 rootfs 而不是事后 opkg install：mihomo 内核 30-50MB，
# 放 squashfs 里压缩存放且不占 overlay。
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
# nikki 的 DEPENDS 写的是 `+mihomo`（虚拟包），meta 与 alpha 都 PROVIDES:mihomo
# 且互相 CONFLICTS。mihomo-meta 带 DEFAULT_VARIANT:=1，这里显式写死避免歧义。
CONFIG_PACKAGE_mihomo-meta=y

# nikki 的运行依赖（默认配置里没有的）
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_yq=y

# --- MAC 降级链需要 fw_printenv --------------------------------------
CONFIG_PACKAGE_uboot-envtools=y

# --- 实用小工具 ------------------------------------------------------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

# --- 编译加速 --------------------------------------------------------
CONFIG_CCACHE=y
